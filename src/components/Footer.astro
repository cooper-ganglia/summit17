---
import { localPath } from '../lib/localPath';
import { site } from '../data/site';
---
<footer class="footer">
  <div class="shell footer-grid">
    <div><p class="footer-logo">SUMMIT<span>17</span></p><p>Anthems of faith.<br />Energy with purpose.</p></div>
    <div><p class="footer-label">Explore</p><a href={localPath('/music')}>Music</a><a href={localPath('/shows')}>Shows</a><a href={localPath('/press-kit')}>Press Kit</a><a href={localPath('/contact')}>Booking</a></div>
    <div><p class="footer-label">Listen & follow</p><a href={site.links.spotify} target="_blank" rel="noopener">Spotify</a><a href={site.links.apple} target="_blank" rel="noopener">Apple Music</a><a href={site.links.instagram} target="_blank" rel="noopener">Instagram</a><a href={site.links.youtube} target="_blank" rel="noopener">YouTube</a></div>
    <div><p class="footer-label">Booking</p><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a><p>Carbondale, Illinois</p></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Summit 17</span><span>Christian alternative rock from Southern Illinois</span></div>
</footer>
<style>
  .footer { padding: 5rem 0 1.5rem; background: #050406; border-top: 1px solid var(--line); }
  .footer-grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 3rem; }
  .footer-grid > div { display: flex; flex-direction: column; align-items: flex-start; gap: .35rem; }
  .footer-grid p { margin-bottom: .5rem; color: var(--muted); }
  .footer-grid a { color: var(--paper); text-decoration: none; }
  .footer-grid a:hover { color: var(--purple-light); }
  .footer-logo { color: white !important; font-family: var(--display); font-size: 2rem; line-height: 1; }
  .footer-logo span { color: var(--purple-light); }
  .footer-label { color: var(--purple-light) !important; font-family: var(--display); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: #817783; font-size: .8rem; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-bottom { flex-direction: column; } }
  @media (max-width: 460px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
