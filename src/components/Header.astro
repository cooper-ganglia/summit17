---
import Icon from './Icon.astro';
import { localPath } from '../lib/localPath';
const path = Astro.url.pathname;
const links = [
  ['/', 'Home'], ['/#about', 'About'], ['/music', 'Music'], ['/shows', 'Shows'], ['/photos', 'Photos'], ['/press-kit', 'Press Kit'], ['/contact', 'Contact']
];
---
<header class="site-header" data-header>
  <a class="brand" href={localPath('/')}><span>SUMMIT</span><b>17</b></a>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation" data-menu-button>
    <span data-menu-open><Icon name="menu" /></span><span hidden data-menu-close><Icon name="close" /></span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-nav>
    {links.map(([href, label]) => <a href={localPath(href)} aria-current={path === localPath(href) ? 'page' : undefined}>{label}</a>)}
    <a class="nav-book" href={localPath('/contact')}>Book the band</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const openIcon = document.querySelector<HTMLElement>('[data-menu-open]');
  const closeIcon = document.querySelector<HTMLElement>('[data-menu-close]');
  const closeMenu = () => {
    button?.setAttribute('aria-expanded', 'false');
    button?.setAttribute('aria-label', 'Open navigation');
    nav?.classList.remove('is-open');
    if (openIcon) openIcon.hidden = false;
    if (closeIcon) closeIcon.hidden = true;
  };
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    if (open) closeMenu(); else {
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', 'Close navigation');
      nav?.classList.add('is-open');
      if (openIcon) openIcon.hidden = true;
      if (closeIcon) closeIcon.hidden = false;
    }
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  addEventListener('scroll', () => header?.classList.toggle('is-scrolled', scrollY > 24), { passive: true });
</script>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 100; min-height: 5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: .9rem var(--gutter); border-bottom: 1px solid transparent; transition: background .2s ease, border-color .2s ease; }
  .site-header.is-scrolled { background: rgba(11,9,13,.94); border-color: var(--line); backdrop-filter: blur(12px); }
  .brand { display: inline-flex; align-items: baseline; color: var(--white); font-family: var(--display); font-size: 1.4rem; letter-spacing: -.04em; text-decoration: none; }
  .brand b { color: var(--purple-light); font-weight: inherit; }
  .site-nav { display: flex; align-items: center; gap: clamp(.8rem, 2vw, 1.75rem); }
  .site-nav a { position: relative; color: var(--white); font-family: var(--display); font-size: .72rem; letter-spacing: .04em; text-decoration: none; text-transform: uppercase; }
  .site-nav a:not(.nav-book)::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -.35rem; height: 2px; background: var(--red); transition: right .2s ease; }
  .site-nav a:hover::after, .site-nav a[aria-current='page']::after { right: 0; }
  .site-nav .nav-book { padding: .65rem .9rem; background: var(--red); }
  .menu-button { display: none; margin-left: auto; flex: 0 0 auto; border: 0; background: transparent; color: white; padding: .5rem; }
  @media (max-width: 880px) {
    .menu-button { display: grid; place-items: center; z-index: 102; }
    .site-nav { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 6rem var(--gutter); background: var(--ink); transform: translateX(100%); visibility: hidden; transition: transform .25s ease, visibility .25s; }
    .site-nav.is-open { transform: translateX(0); visibility: visible; }
    .site-nav a { font-size: clamp(1.7rem, 8vw, 3.3rem); line-height: 1; }
    .site-nav .nav-book { margin-top: 1rem; font-size: 1rem; }
  }
</style>
