---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../data/site';
interface Props { photos: Photo[]; preview?: boolean; }
const { photos, preview = false } = Astro.props;
const shown = preview ? photos.slice(0, 6) : photos;
const items = await Promise.all(shown.map(async ({ image, depth, alt }) => ({
  src: (await getImage({ src: image, width: Math.min(image.width, 1600), format: 'webp', quality: 84 })).src,
  depth: (await getImage({ src: depth, format: 'png' })).src,
  alt,
  width: image.width,
  height: image.height
})));
---
<div class:list={['photo-grid', { preview }]} data-gallery data-items={JSON.stringify(items)}>
  {shown.map((photo, index) => (
    <button class:list={['photo', photo.orientation]} type="button" data-photo={index} title={`Open photo ${index + 1}: ${photo.alt}`}>
      <Image src={photo.image} alt={photo.alt} widths={[420, 720, 1100]} sizes={preview ? '(max-width: 700px) 100vw, 33vw' : '(max-width: 700px) 100vw, 30vw'} loading="lazy" />
      <span aria-hidden="true">View <b>{String(index + 1).padStart(2, '0')}</b></span>
    </button>
  ))}
  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <button class="lightbox-close" type="button" data-close aria-label="Close photo viewer">×</button>
    <button class="depth-toggle" type="button" data-depth-toggle aria-pressed="false">Depth motion: off</button>
    <button class="lightbox-nav previous" type="button" data-prev aria-label="Previous photo">←</button>
    <div class="lightbox-stage" data-stage>
      <img data-lightbox-image alt="" />
      <canvas data-depth-canvas aria-hidden="true"></canvas>
    </div>
    <p data-caption></p>
    <button class="lightbox-nav next" type="button" data-next aria-label="Next photo">→</button>
  </dialog>
</div>

<script>import '../scripts/galleryLightbox';</script>

<style>
  .photo-grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-flow: dense; gap: clamp(.65rem, 1.2vw, 1.1rem); }
  .photo { position: relative; grid-column: span 4; margin: 0; padding: 0; overflow: hidden; border: 0; background: #111; color: white; cursor: zoom-in; min-height: 18rem; }
  .photo.portrait { grid-row: span 2; }
  .photo.landscape { grid-column: span 8; }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease, filter .35s ease; }
  .photo:hover img { transform: scale(1.025); filter: contrast(1.05); }
  .photo > span { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; padding: .8rem; background: linear-gradient(transparent, rgba(0,0,0,.8)); font-family: var(--display); font-size: .75rem; letter-spacing: .05em; text-transform: uppercase; opacity: 0; transition: opacity .2s; }
  .photo:hover > span, .photo:focus-visible > span { opacity: 1; }
  .preview .photo { min-height: 14rem; }
  .preview .photo:nth-child(n+4) { grid-column: span 4; }
  .lightbox { width: min(94vw, 82rem); max-height: 92vh; padding: 0; border: 1px solid rgba(255,255,255,.25); background: #050406; color: white; }
  .lightbox::backdrop { background: rgba(0,0,0,.9); backdrop-filter: blur(5px); }
  .lightbox-stage { position: relative; width: min(100%, calc(80vh * var(--image-ratio, 1))); aspect-ratio: var(--image-ratio, 1); margin: 0 auto; }
  .lightbox-stage img, .lightbox-stage canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .lightbox-stage img { object-fit: contain; }
  .lightbox-stage canvas { opacity: 0; pointer-events: none; }
  .lightbox-stage canvas.active { opacity: 1; }
  .lightbox p { margin: 0; padding: .8rem 4rem; color: var(--muted); font-size: .85rem; text-align: center; }
  .lightbox-close, .lightbox-nav, .depth-toggle { position: absolute; z-index: 2; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.2); background: rgba(11,9,13,.72); color: white; cursor: pointer; transition: opacity .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease; }
  .lightbox-close { top: .75rem; right: .75rem; width: 3rem; height: 3rem; font-size: 2rem; }
  .depth-toggle { top: .75rem; left: .75rem; min-height: 3rem; padding: 0 .85rem; font-family: var(--display); font-size: .65rem; letter-spacing: .06em; text-transform: uppercase; }
  .depth-toggle[aria-pressed="true"] { background: var(--purple); border-color: var(--purple-light); }
  .lightbox-nav { top: 50%; width: 3rem; height: 4rem; font-size: 1.5rem; opacity: .55; transform: translateY(-50%); }
  .lightbox-nav.previous { left: .75rem; } .lightbox-nav.next { right: .75rem; }
  .lightbox-nav:hover, .lightbox-nav:focus-visible { opacity: 1; background: var(--purple); border-color: var(--purple-light); }
  .lightbox-nav.previous:hover, .lightbox-nav.previous:focus-visible { transform: translate(-3px, -50%); }
  .lightbox-nav.next:hover, .lightbox-nav.next:focus-visible { transform: translate(3px, -50%); }
  .lightbox-close:hover, .lightbox-close:focus-visible, .depth-toggle:hover, .depth-toggle:focus-visible { background: var(--purple); border-color: var(--purple-light); }
  @media (max-width: 700px) { .photo, .photo.landscape, .preview .photo:nth-child(n+4) { grid-column: span 12; min-height: 17rem; } .photo.portrait { min-height: 26rem; } .lightbox p { padding: .8rem 3.5rem; } }
  @media (hover: none), (prefers-reduced-motion: reduce) { .depth-toggle { display: none; } }
  @media (prefers-reduced-motion: reduce) { .lightbox-close, .lightbox-nav, .depth-toggle { transition: none; } }
</style>
