---
import { Image } from 'astro:assets';
import type { Photo } from '../data/site';
interface Props { photos: Photo[]; preview?: boolean; }
const { photos, preview = false } = Astro.props;
const shown = preview ? photos.slice(0, 6) : photos;
---
<div class:list={['photo-grid', { preview }]} data-gallery>
  {shown.map((photo, index) => (
    <button class:list={['photo', photo.orientation]} type="button" data-photo={index} title={`Open photo ${index + 1}: ${photo.alt}`}>
      <Image src={photo.image} alt={photo.alt} widths={[420, 720, 1100]} sizes={preview ? '(max-width: 700px) 100vw, 33vw' : '(max-width: 700px) 100vw, 30vw'} loading="lazy" />
      <span aria-hidden="true">View <b>{String(index + 1).padStart(2, '0')}</b></span>
    </button>
  ))}
  {!preview && (
    <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
      <button class="lightbox-close" type="button" data-close aria-label="Close photo viewer">×</button>
      <button class="lightbox-nav previous" type="button" data-prev aria-label="Previous photo">←</button>
      <img data-lightbox-image alt="" />
      <p data-caption></p>
      <button class="lightbox-nav next" type="button" data-next aria-label="Next photo">→</button>
    </dialog>
  )}
</div>
{!preview && <script is:inline type="application/json" data-gallery-data set:html={JSON.stringify(shown.map(({ image, alt }) => ({ src: image.src, alt })))} />}

{!preview && <script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = gallery?.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = dialog?.querySelector<HTMLElement>('[data-caption]');
  const dataNode = document.querySelector<HTMLScriptElement>('[data-gallery-data]');
  const items: { src: string; alt: string }[] = dataNode ? JSON.parse(dataNode.textContent ?? '[]') : [];
  let active = 0;
  const show = (index: number) => { active = (index + items.length) % items.length; if (image) { image.src = items[active].src; image.alt = items[active].alt; } if (caption) caption.textContent = `${String(active + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')} — ${items[active].alt}`; };
  gallery?.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((button) => button.addEventListener('click', () => { show(Number(button.dataset.photo)); dialog?.showModal(); }));
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => show(active - 1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') show(active - 1); if (event.key === 'ArrowRight') show(active + 1); });
</script>}

<style>
  .photo-grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-flow: dense; gap: clamp(.65rem, 1.2vw, 1.1rem); }
  .photo { position: relative; grid-column: span 4; margin: 0; padding: 0; overflow: hidden; border: 0; background: #111; color: white; cursor: zoom-in; min-height: 18rem; }
  .photo.portrait { grid-row: span 2; }
  .photo.landscape { grid-column: span 8; }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease, filter .35s ease; }
  .photo:hover img { transform: scale(1.025); filter: contrast(1.05); }
  .photo > span { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; padding: .8rem; background: linear-gradient(transparent, rgba(0,0,0,.8)); font-family: var(--display); font-size: .75rem; letter-spacing: .05em; text-transform: uppercase; opacity: 0; transition: opacity .2s; }
  .photo:hover > span, .photo:focus-visible > span { opacity: 1; }
  .preview .photo { min-height: 14rem; }
  .preview .photo:nth-child(n+4) { grid-column: span 4; }
  .lightbox { width: min(94vw, 82rem); max-height: 92vh; padding: 0; border: 1px solid rgba(255,255,255,.25); background: #050406; color: white; }
  .lightbox::backdrop { background: rgba(0,0,0,.9); backdrop-filter: blur(5px); }
  .lightbox img { width: 100%; max-height: 80vh; object-fit: contain; }
  .lightbox p { margin: 0; padding: .8rem 4rem; color: var(--muted); font-size: .85rem; text-align: center; }
  .lightbox-close, .lightbox-nav { position: absolute; z-index: 2; display: grid; place-items: center; border: 0; background: rgba(11,9,13,.85); color: white; cursor: pointer; }
  .lightbox-close { top: .75rem; right: .75rem; width: 3rem; height: 3rem; font-size: 2rem; }
  .lightbox-nav { top: 50%; width: 3rem; height: 4rem; font-size: 1.5rem; }
  .lightbox-nav.previous { left: .75rem; } .lightbox-nav.next { right: .75rem; }
  @media (max-width: 700px) { .photo, .photo.landscape, .preview .photo:nth-child(n+4) { grid-column: span 12; min-height: 17rem; } .photo.portrait { min-height: 26rem; } }
</style>
