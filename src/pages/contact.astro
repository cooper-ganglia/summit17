---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { localPath } from '../lib/localPath';
const isPages = import.meta.env.PUBLIC_PAGES_BASE === '/summit17';
---
<BaseLayout title="Booking & Contact" description="Book Summit 17 for churches, festivals, youth events, conferences, schools, and community outreach events.">
  <PageHero eyebrow="Booking & contact" title="Bring the / energy" intro="Booking churches, festivals, youth events, conferences, schools, and community outreach events." number="05" />
  <section class="section contact-section"><div class="shell contact-grid"><div class="contact-copy"><p class="eyebrow">Let's build the night</p><h2>Tell us about your event.</h2><p class="lede">Summit 17 brings original Christian alternative rock, a family-friendly high-energy performance, professional communication, and an easy advance process.</p><div class="direct-contact"><a href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong></a><a href={`tel:${site.phoneHref}`}><span>Text</span><strong>{site.phoneDisplay}</strong></a></div><div class="social-contact"><a href={site.links.facebook} target="_blank" rel="noopener">Facebook <Icon name="external" size={16} /></a><a href={site.links.instagram} target="_blank" rel="noopener">Instagram <Icon name="external" size={16} /></a><a href={site.links.youtube} target="_blank" rel="noopener">YouTube <Icon name="external" size={16} /></a></div></div>{isPages ? (
  <div class="form-card"><p class="eyebrow">Booking inquiries</p><h3>Tell us about your event.</h3><p>Send the details directly to the band by email. Include your date, venue, and the kind of event you have in mind.</p><a class="button" href={`mailto:${site.email}?subject=Summit%2017%20booking%20inquiry`}>Email the band <Icon name="arrow" /></a><p class="form-note">Your email app will open so you can write and send your request.</p></div>
) : (<div class="form-card"><form name="booking" method="POST" action={localPath('/thank-you')} data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="booking" /><p class="sr-only"><label>Don’t fill this out if you’re human: <input name="bot-field" /></label></p><div class="field-row"><label><span>Name *</span><input type="text" name="name" autocomplete="name" required /></label><label><span>Email *</span><input type="email" name="email" autocomplete="email" required /></label></div><label><span>Phone number</span><input type="tel" name="phone" autocomplete="tel" /></label><label><span>Event type</span><select name="event-type"><option value="">Choose one</option><option>Church</option><option>Festival</option><option>Youth event</option><option>Conference</option><option>School</option><option>Community outreach</option><option>Other</option></select></label><label><span>Message *</span><textarea name="message" rows="7" required></textarea></label><button class="button" type="submit">Send booking request <Icon name="arrow" /></button><p class="form-note">Your details go directly to Summit 17 for this booking request. No marketing list, no tracking.</p></form></div>)}</div></section>
</BaseLayout>
<style>
  .contact-section { background: radial-gradient(circle at 80% 20%, rgba(113,48,174,.25), transparent 35%); }
  .contact-grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .contact-grid > * { min-width: 0; }
  .contact-copy { position: sticky; top: 7rem; }
  .direct-contact { display: grid; margin: 2.5rem 0; border-top: 1px solid var(--line); }
  .direct-contact a { display: grid; gap: .15rem; padding: 1.15rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .direct-contact span { color: var(--purple-light); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  .direct-contact strong { font-family: var(--display); font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 400; text-transform: uppercase; overflow-wrap: anywhere; }
  .social-contact { display: flex; flex-wrap: wrap; gap: 1rem; }
  .social-contact a { display: inline-flex; align-items: center; gap: .25rem; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
  .form-card { padding: clamp(1.5rem, 4vw, 3rem); background: var(--paper); color: var(--ink); box-shadow: 1rem 1rem 0 var(--purple); }
  form { display: grid; gap: 1.2rem; }
  label { display: grid; gap: .45rem; }
  label > span { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
  input, select, textarea { width: 100%; min-width: 0; border: 1px solid #bdb4c0; border-radius: 0; background: #fff; color: var(--ink); padding: .85rem; }
  textarea { resize: vertical; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-card .button { justify-self: start; }
  .form-note { color: #665e68; font-size: .78rem; }
  @media (max-width: 800px) { .contact-grid { grid-template-columns: 1fr; } .contact-copy { position: static; } }
  @media (max-width: 520px) { .field-row { grid-template-columns: 1fr; } }
</style>
