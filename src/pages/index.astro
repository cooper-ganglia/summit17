---
import { localPath } from '../lib/localPath';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import ShowCard from '../components/ShowCard.astro';
import DepthPhoto from '../components/DepthPhoto.astro';
import Icon from '../components/Icon.astro';
import { media, photos, site, tracks } from '../data/site';

const schema = {
  '@context': 'https://schema.org', '@type': 'MusicGroup', name: site.name, url: site.url,
  genre: ['Christian alternative rock', 'Christian rock', 'Pop punk'], foundingLocation: 'Carbondale, Illinois',
  sameAs: [site.links.spotify, site.links.apple, site.links.facebook, site.links.instagram, site.links.youtube]
};
const featured = [
  { name: 'Kingdom Come Festival', url: 'https://www.kingdomcomefestival.com/' },
  { name: 'Audiofeed', url: 'https://audiofeedfestival.com/' },
  { name: 'Hope Fest', url: 'https://hopefestevent.org/' }
];
const sharedStage = [
  { name: 'Ignescent', url: 'https://ignescentmusic.com/' },
  { name: 'Undefeated', url: 'https://www.undefeatedofficial.com/' },
  { name: 'Drown the Planet', url: 'https://linktr.ee/drowntheplanet_' },
  { name: 'Lee Marie', url: 'https://leemarieband.com/' }
];
---
<BaseLayout schema={schema}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-visual">
      <Image class="hero-image" src={media.heroWide} alt="The three members of Summit 17 seated beneath the Summit 17 wordmark, visible from logo to shoes" widths={[480, 800, 1200, 1672]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
      <div class="hero-shade"></div>
    </div>
    <div class="hero-copy">
      <div class="shell hero-content">
        <div class="hero-heading">
          <p class="eyebrow">Christian alternative rock · Carbondale, Illinois</p>
          <h1 id="hero-title"><span>Anthems of faith.</span><br />Energy with <em>purpose.</em></h1>
        </div>
        <div class="hero-intro">
          <p>Raw passion. Hope-filled lyrics. Powerful live shows that shake the room and point people toward Christ.</p>
          <div class="button-row"><a class="button" href={localPath('/music')}>Listen now <Icon name="arrow" /></a><a class="button button-ghost" href={localPath('/contact')}>Book Summit 17</a></div>
          <a class="hero-scroll" href="#about">Discover the band <span>↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-paper about" id="about">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">About the band</p><h2>Hope turned<br />all the way up.</h2></div><span class="kicker-number">01</span></div>
      <div class="about-grid">
        <DepthPhoto photo={media.aboutPhoto} depth={media.aboutDepth} />
        <div class="about-copy">
          <h3>Igniting hope and moving hearts.</h3>
          <p>Based out of <strong>Carbondale, Illinois</strong>, Summit 17 is a high-energy Christian alternative rock band delivering anthems of hope, faith, and joy with every performance. Known for powerful live shows, heavy guitar riffs, and singable choruses, Summit 17 blends passion, authenticity, and purpose into a sound that's both energetic and encouraging.</p>
          <p>Their faith-filled lyrics speak to real struggles and real victories, offering a message of unwavering hope and identity in Christ. Whether performing at festivals, churches, youth events, schools, or community venues, Summit 17 creates an atmosphere where people can have fun, be encouraged, and encounter the hope found in Jesus.</p>
          <p>From explosive rock moments to uplifting declarations, Summit 17 creates music that's both raw and refreshing—Christian alternative rock that moves hearts, shakes the room, and points people toward Christ.</p>
          <a class="button button-dark" href={site.links.livePlaylist} target="_blank" rel="noopener">Watch live <Icon name="external" /></a>
        </div>
      </div>
      <div class="credits"><div><span>Featured at</span><p class="credits-links">{featured.map(({ name, url }, index) => <span class="credit-item"><a href={url} target="_blank" rel="noopener">{name}</a>{index < featured.length - 1 && <i aria-hidden="true">·</i>}</span>)}</p></div><div><span>Shared the stage with</span><p class="credits-links">{sharedStage.map(({ name, url }, index) => <span class="credit-item"><a href={url} target="_blank" rel="noopener">{name}</a>{index < sharedStage.length - 1 && <i aria-hidden="true">·</i>}</span>)}</p></div></div>
    </div>
  </section>

  <section class="section music-feature">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Latest music</p><h2>Turn it up.</h2></div><span class="kicker-number">02</span></div>
      <div class="music-grid">
        <div class="album-art"><Image src={media.hero} alt="Summit 17 album artwork" widths={[480, 780, 1000]} sizes="(max-width: 800px) 90vw, 36vw" loading="lazy" /><span>Summit 17 / Self-titled</span></div>
        <div><AudioPlayer tracks={tracks} compact /><div class="stream-row"><span>Stream everywhere</span><a href={site.links.spotify} target="_blank" rel="noopener">Spotify</a><a href={site.links.apple} target="_blank" rel="noopener">Apple Music</a><a href={site.links.distrokid} target="_blank" rel="noopener">All platforms</a></div><a class="text-link" href={localPath('/music')}>Hear all eight tracks <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <section class="section show-feature">
    <div class="show-backdrop"><Image src={media.shows} alt="" widths={[900, 1500, 2200]} sizes="100vw" loading="lazy" /></div>
    <div class="shell"><div class="section-heading"><div><p class="eyebrow">On the road</p><h2>Live & loud.</h2></div><span class="kicker-number">03</span></div><ShowCard /><p class="show-more"><a class="text-link" href={localPath('/shows')}>All shows and Bandsintown <Icon name="arrow" /></a></p></div>
  </section>

  <section class="section photos-feature">
    <div class="shell"><div class="section-heading"><div><p class="eyebrow">From the pit</p><h2>Live energy.</h2></div><span class="kicker-number">04</span></div><PhotoGrid photos={photos} preview /><p class="gallery-link"><a class="button button-ghost" href={localPath('/photos')}>View the full gallery <Icon name="arrow" /></a></p></div>
  </section>

  <section class="section section-purple experience-cta">
    <div class="shell experience-grid"><p class="eyebrow">Bring the experience</p><h2>Looking for more than just a concert?</h2><div><h3>We Are the Light</h3><p class="lede">Bring a full Christian alternative music experience to your church, festival, campus, youth group, or community. Summit 17 combines high-energy live music, authentic faith, and meaningful connection to create events that entertain, encourage, and point people toward Jesus.</p><a class="button button-dark" href={localPath('/contact')}>Start a conversation <Icon name="arrow" /></a></div></div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; overflow: hidden; background: var(--ink); }
  .hero-visual { position: relative; aspect-ratio: 1672 / 941; overflow: hidden; background: #c8c5c5; }
  .hero-image { display: block; width: 100%; height: 100%; object-fit: contain; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(7,5,8,.35), transparent 26%), linear-gradient(90deg, rgba(7,5,8,.14), transparent 25%); }
  .hero-copy { position: relative; z-index: 2; padding: clamp(2.5rem, 5vw, 4.5rem) 0; border-top: 1px solid var(--line); background: radial-gradient(circle at 12% 20%, rgba(113,48,174,.2), transparent 26%), var(--ink); }
  .hero-content { display: grid; grid-template-columns: 1.25fr .75fr; align-items: end; gap: clamp(2rem, 7vw, 8rem); }
  .hero-content h1 { max-width: 12ch; margin-bottom: 0; font-size: clamp(3.25rem, 5.6vw, 6.5rem); }
  .hero-content h1 span { color: var(--paper); }
  .hero-content h1 em { color: var(--purple-light); font-style: normal; }
  .hero-intro > p { max-width: 34rem; margin-bottom: 1.75rem; color: #d8d0da; font-size: 1.1rem; }
  .hero-scroll { display: inline-flex; align-items: center; gap: .8rem; margin-top: 1.5rem; color: #d5ced7; font-size: .72rem; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
  .hero-scroll span { color: var(--red); font-size: 1.3rem; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: clamp(2rem, 4vw, 4rem); }
  .about-copy h3 { color: var(--purple); }
  .credits { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 6rem; background: rgba(11,9,13,.2); border: 1px solid rgba(11,9,13,.2); }
  .credits div { padding: 1.5rem; background: var(--paper); }
  .credits > div > span { display: block; margin-bottom: .4rem; color: var(--red); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  .credits-links { display: flex; flex-wrap: wrap; gap: .25rem .6rem; margin: 0; }
  .credit-item { display: inline-flex; align-items: baseline; white-space: nowrap; }
  .credits-links a { color: var(--ink); font-family: var(--display); font-size: clamp(1.05rem, 1.5vw, 1.45rem); line-height: 1.2; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .2em; text-transform: uppercase; transition: color .2s ease, text-decoration-color .2s ease, transform .2s ease; }
  .credit-item i { margin-left: .6rem; color: var(--red); font-size: 1.2rem; font-style: normal; line-height: 1; }
  .credits-links a:hover, .credits-links a:focus-visible { color: var(--purple); text-decoration-color: currentColor; transform: translateY(-2px); }
  .music-feature { background: radial-gradient(circle at 90% 10%, rgba(113,48,174,.28), transparent 35%), var(--ink); }
  .music-grid { display: grid; grid-template-columns: minmax(18rem, .72fr) 1.3fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .album-art { position: relative; transform: rotate(1.5deg); box-shadow: -1rem 1rem 0 var(--red); }
  .album-art img { width: 100%; }
  .album-art span { position: absolute; left: 1rem; bottom: 1rem; padding: .45rem .7rem; background: var(--ink); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; }
  .stream-row { display: flex; flex-wrap: wrap; gap: .8rem 1.3rem; padding: 1.5rem 0; color: var(--muted); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
  .stream-row a { color: var(--paper); }
  .show-feature { overflow: hidden; }
  .show-backdrop { position: absolute; inset: 0; }
  .show-backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(11,9,13,.87), rgba(11,9,13,.96)); }
  .show-backdrop img { width: 100%; height: 100%; object-fit: cover; }
  .show-feature .shell { position: relative; }
  .show-more, .gallery-link { margin: 2rem 0 0; text-align: right; }
  .photos-feature { background: var(--ink-soft); }
  .experience-grid { display: grid; grid-template-columns: .6fr 1.6fr 1fr; gap: clamp(1.25rem, 3vw, 2.5rem); align-items: start; }
  .experience-grid .eyebrow, .experience-grid h2 { margin-bottom: 0; }
  .experience-grid h2 { font-size: clamp(3rem, 7vw, 7rem); }
  .experience-grid h3 { color: var(--paper); }
  .experience-cta { padding-block: clamp(2.25rem, 4vw, 3.5rem); background: radial-gradient(circle at 70% 5%, rgba(255,255,255,.065), transparent 40%), var(--purple); }
  .experience-cta::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .09; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)'/%3E%3C/svg%3E"); mix-blend-mode: screen; }
  .experience-grid { position: relative; }
  @media (max-width: 850px) { .hero-content, .music-grid, .about-grid { grid-template-columns: 1fr; } .hero-content { align-items: start; gap: 2rem; } .album-art { max-width: 32rem; margin-inline: auto; } .experience-grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .hero-shade { background: linear-gradient(0deg, rgba(7,5,8,.25), transparent 35%); } .hero-content .eyebrow { max-width: 21rem; line-height: 1.4; } .credits { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .credits-links a { transition: none; } }
  @media (max-width: 430px) { .hero-content h1 { font-size: 3rem; } .home-hero .button-row { display: grid; grid-template-columns: 1fr; } .home-hero .button { width: 100%; } }
</style>
