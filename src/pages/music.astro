---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Icon from '../components/Icon.astro';
import { media, site, tracks } from '../data/site';
const schema = { '@context': 'https://schema.org', '@type': 'MusicAlbum', name: 'Summit 17', byArtist: { '@type': 'MusicGroup', name: 'Summit 17' }, track: tracks.map((track) => ({ '@type': 'MusicRecording', name: track.title, duration: track.duration })) };
---
<BaseLayout title="Music" description="Listen to Summit 17's Christian alternative rock songs and find the band on Spotify, Apple Music, and every major streaming platform." schema={schema}>
  <PageHero eyebrow="Listen" title="Music / Built for the room" intro="Heavy guitar riffs, singable choruses, and declarations of hope—stream the self-titled release or press play right here." number="01" />
  <section class="section music-page"><div class="shell music-layout"><div class="album-column"><Image src={media.hero} alt="Summit 17 album cover" widths={[520, 800, 1100]} sizes="(max-width: 850px) 88vw, 36vw" /><p>Summit 17 · Self-titled</p><div class="button-row"><a class="button" href={site.links.distrokid} target="_blank" rel="noopener">Stream everywhere <Icon name="external" /></a><a class="button button-ghost" href={site.links.livePlaylist} target="_blank" rel="noopener">Watch live</a></div></div><div><p class="eyebrow">Eight tracks</p><h2>Play it loud.</h2><AudioPlayer tracks={tracks} /></div></div></section>
  <section class="section section-paper"><div class="shell platform-grid"><div><p class="eyebrow">Take it with you</p><h2>Choose your platform.</h2></div><a href={site.links.spotify} target="_blank" rel="noopener"><span>01</span><strong>Spotify</strong><Icon name="external" /></a><a href={site.links.apple} target="_blank" rel="noopener"><span>02</span><strong>Apple Music</strong><Icon name="external" /></a><a href={site.links.distrokid} target="_blank" rel="noopener"><span>03</span><strong>Everywhere else</strong><Icon name="external" /></a></div></section>
</BaseLayout>
<style>
  .music-page { background: radial-gradient(circle at 20% 30%, rgba(113,48,174,.25), transparent 35%); }
  .music-layout { display: grid; grid-template-columns: .72fr 1.28fr; align-items: start; gap: clamp(2rem, 6vw, 6rem); }
  .album-column { position: sticky; top: 7rem; }
  .album-column > img { width: 100%; box-shadow: -1rem 1rem 0 var(--purple); }
  .album-column > p { color: var(--muted); letter-spacing: .12em; text-transform: uppercase; }
  .platform-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: rgba(11,9,13,.2); border: 1px solid rgba(11,9,13,.2); }
  .platform-grid > * { min-width: 0; background: var(--paper); padding: clamp(1.25rem, 2vw, 2rem); }
  .platform-grid > div { grid-column: 1 / -1; padding-block: 2.25rem 1.75rem; }
  .platform-grid h2 { max-width: none; margin: 0; font-size: clamp(2.5rem, 5vw, 5rem); }
  .platform-grid a { min-height: 7.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--ink); text-decoration: none; transition: background .2s ease, color .2s ease; }
  .platform-grid a:hover, .platform-grid a:focus-visible { background: var(--purple); color: white; }
  .platform-grid a span { color: var(--red); font-size: .75rem; }
  .platform-grid a strong { flex: 1; font-family: var(--display); font-size: clamp(1.5rem, 2vw, 2rem); font-weight: 400; line-height: 1.1; text-transform: uppercase; }
  @media (max-width: 850px) { .music-layout { grid-template-columns: 1fr; } .album-column { position: static; max-width: 34rem; } }
  @media (max-width: 680px) { .platform-grid { grid-template-columns: 1fr; } .platform-grid a { min-height: 5.75rem; } }
  @media (prefers-reduced-motion: reduce) { .platform-grid a { transition: none; } }
</style>
